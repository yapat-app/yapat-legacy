# YAPAT Environment Configuration Example
# Copy this file to .env and adjust the values accordingly

# Server Configuration
# ------------------
# Host IP to bind the server to (use 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port number for the server (default: 1050)
PORT=1050

# Enable debug mode for development (true/false)
DEBUG=false

# Enable DevTools props checking (true/false)
DEV_TOOLS_PROPS_CHECK=false

# Security Configuration
# --------------------
# Secret key for session management (must be changed in production)
SECRET_KEY=change-this-in-production

# API key for external integrations
API_KEY=change-this-in-production

# Database Configuration
# --------------------
# SQLite database paths are relative to instance directory
USER_DB_PATH=user.db
PIPELINE_DB_PATH=pipeline.db

# Model Configuration
# -----------------
# Path to pretrained models (optional)
MODEL_PATH=/path/to/models

# Storage Configuration
# -------------------
# Directory for storing audio files
AUDIO_STORAGE_PATH=/path/to/audio/storage

# Directory for storing embeddings
EMBEDDINGS_STORAGE_PATH=/path/to/embeddings/storage